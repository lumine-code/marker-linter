{
  "name": "marker-linter",
  "author": "lumine-code",
  "description": "Show linter messages on the scrollbar and minimap.",
  "repository": "https://github.com/lumine-code/marker-linter",
  "bugs": {
    "url": "https://github.com/lumine-code/marker-linter/issues"
  },
  "keywords": [
    "overview-ruler",
    "gutter",
    "annotation",
    "decoration",
    "scrollmap",
    "minimap",
    "diagnostics",
    "error"
  ],
  "version": "1.2.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "marker.layer": {
      "versions": {
        "1.0.0": "provideMarkerLayer"
      }
    },
    "linter.ui": {
      "versions": {
        "1.0.0": "provideLinterUI"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "showHints": {
      "title": "Show hints",
      "description": "Show messages of hint severity. Hints are usually numerous and would trip the threshold below.",
      "type": "boolean",
      "default": false
    },
    "threshold": {
      "title": "Threshold",
      "description": "Hide markers if count exceeds this value. Zero means no limit.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  }
}
